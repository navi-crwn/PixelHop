# PixelHop 3 settings. Every line is optional; these are the defaults.

# Where to listen, and the public address people use (no trailing slash).
PIXELHOP_ADDR=:8080
PIXELHOP_BASE_URL=http://localhost:8080
PIXELHOP_SITE_NAME=PixelHop

# Database and (with local storage) the images live here.
PIXELHOP_DATA=./data

# Limits
PIXELHOP_MAX_UPLOAD_MB=20
PIXELHOP_MAX_MEDIA_MB=100
PIXELHOP_GUEST_MAX_MB=20
PIXELHOP_MAX_BATCH=20
PIXELHOP_MAX_MEGAPIXELS=80
PIXELHOP_UPLOADS_PER_MINUTE=30
PIXELHOP_DEFAULT_QUOTA_MB=1024
# Delete images nobody has viewed for this many days (0 = keep forever).
PIXELHOP_INACTIVE_DAYS=0

# Defaults for the switches in the control center's settings.
PIXELHOP_GUEST_UPLOADS=true
PIXELHOP_REGISTRATION=true

# Shown on the Terms page for copyright notices.
PIXELHOP_CONTACT_EMAIL=

# Behind Cloudflare or a reverse proxy? List who may set X-Forwarded-For /
# CF-Connecting-IP: "cloudflare", IPs or CIDRs, comma separated.
# Leave empty when PixelHop faces the internet directly.
PIXELHOP_TRUSTED_PROXIES=

# Storage: "local" (disk) or "s3" (AWS, Cloudflare R2, MinIO, Backblaze B2, Contabo, Wasabi...)
PIXELHOP_STORAGE=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true
# Optional public/CDN address of the bucket; image links then redirect there.
S3_PUBLIC_URL=

# Sign in with Google (optional). Register the redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to $PIXELHOP_BASE_URL/auth/google/callback. PixelHop 2 used /auth/google-callback.
GOOGLE_REDIRECT_URI=

# One account with HEL.ink (optional). Use the same 32+ character secret as
# PIXELHOP_SSO_SECRET in HEL.ink's .env. Sign-up and resets then happen on HEL.ink.
HELINK_URL=
HELINK_SSO_SECRET=
# Where the HOP control center lives (optional). Admins who open /admin are
# sent there; moderation and site settings happen in the control center
# through the signed /hop/* API (or with the CLI).
PIXELHOP_CONTROL_URL=

# Cloudflare Turnstile on PixelHop's own sign-in and sign-up forms (optional).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server AI tools (optional): address of tools/ai-server.py.
PIXELHOP_REMBG_URL=
PIXELHOP_REMBG_PER_DAY=30
