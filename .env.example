# PixelHop 3 settings. Every line is optional; these are the defaults.

# Where to listen, and the public address people use (no trailing slash).
PIXELHOP_ADDR=:8080
PIXELHOP_BASE_URL=http://localhost:8080
# Optional: another host for shared links (pages, /i/ and /t/ files), e.g.
# the old address after moving the app. It must also reach PixelHop.
# PIXELHOP_LINK_URL=https://img.example.com
PIXELHOP_SITE_NAME=PixelHop

# Database and (with local storage) the images live here.
PIXELHOP_DATA=./data

# Limits
PIXELHOP_MAX_UPLOAD_MB=20
PIXELHOP_MAX_MEDIA_MB=100
PIXELHOP_GUEST_MAX_MB=20
PIXELHOP_MAX_BATCH=20
PIXELHOP_MAX_MEGAPIXELS=80
PIXELHOP_UPLOADS_PER_MINUTE=30
# Guests (no account): images per album and files per address per 24 hours.
# 0 turns a limit off. Both can also be changed from the control center.
PIXELHOP_GUEST_ALBUM_MAX=10
PIXELHOP_GUEST_DAILY_MAX=25
# Days a NEW guest upload stays online (0 = until deleted). Older files and
# member uploads are not changed. Also a control center setting.
PIXELHOP_GUEST_TTL_DAYS=30
# One stored file when different people upload the same picture: each keeps their own link, owner
# and expiry, the bytes are stored once. false = every upload stores its own copy. Pictures already
# stored are not changed either way. Also a control center setting (share_storage).
PIXELHOP_SHARE_STORAGE=true
# Storage for each new account. Existing accounts keep their quota.
PIXELHOP_DEFAULT_QUOTA_MB=128
# Delete images nobody has viewed for this many days (0 = keep forever).
PIXELHOP_INACTIVE_DAYS=0

# Uploads stop when free disk space falls below the larger of these two.
PIXELHOP_MIN_FREE_MB=1024
PIXELHOP_MIN_FREE_PERCENT=5

# Defaults for the switches in the control center's settings.
PIXELHOP_GUEST_UPLOADS=true
PIXELHOP_REGISTRATION=true
PIXELHOP_READ_ONLY=false

# Shown on the Terms page for copyright notices.
PIXELHOP_CONTACT_EMAIL=

# Behind Cloudflare or a reverse proxy? List who may set X-Forwarded-For /
# CF-Connecting-IP: "cloudflare", IPs or CIDRs, comma separated.
# Leave empty when PixelHop faces the internet directly.
PIXELHOP_TRUSTED_PROXIES=

# Storage: "local" (disk) or "s3" (AWS, Cloudflare R2, MinIO, Backblaze B2, Contabo, Wasabi...)
PIXELHOP_STORAGE=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true
# Optional public/CDN address of the bucket; image links then redirect there.
S3_PUBLIC_URL=

# Sign in with Google (optional). Register the redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to $PIXELHOP_BASE_URL/auth/google/callback. PixelHop 2 used /auth/google-callback.
GOOGLE_REDIRECT_URI=

# One account with HEL.ink (optional). Use the same 32+ character secret as
# PIXELHOP_SSO_SECRET in HEL.ink's .env. Sign-up and resets then happen on HEL.ink.
HELINK_URL=
HELINK_SSO_SECRET=
# Used when HELINK_SSO_SECRET is empty, in this order, for a shared HOP env file.
# HOP_SSO_SECRET_PIXELHOP=
# HOP_SSO_SECRET=
# The previous secret, still accepted while you change it on both sides.
# HELINK_SSO_SECRET_PREV=
# Used when HELINK_SSO_SECRET_PREV is empty.
# HOP_SSO_SECRET_PREV=
# Apps that may call the signed /hop/* API.
HOP_ADMIN_CLIENTS=imperium,helink
# Apps that may list a member's own files for them (GET /api/v1/me/media, signed
# as the app with X-HOP-Actor = the member's HOP ID): BioHop's media picker.
# They are verified with HELINK_SSO_SECRET; a family with one secret per app
# puts that app's secret in HOP_SSO_SECRET_<APP>, e.g. HOP_SSO_SECRET_BIOHOP.
PIXELHOP_MEDIA_CLIENTS=biohop
# HOP_SSO_SECRET_BIOHOP=
# A secret only for the picker calls (32+ characters), the same value as HOP_PICKER_SECRET in BioHop. With it set
# there, HOP_SSO_SECRET_BIOHOP above is no longer needed and should be removed: it is BioHop's sign-in secret.
# HOP_PICKER_SECRET=
# Apps that may store a file in a member's library for them (POST /hop/media, FileHop's "Save to PixelHop").
# Each one needs its own secret, 32+ characters, the same value as in that app: HOP_STORE_SECRET_<APP>.
# Empty = the endpoint is off.
PIXELHOP_STORE_CLIENTS=
# HOP_STORE_SECRET_FILEHOP=
# Where the HOP control center lives (optional). Admins who open /admin are
# sent there; moderation and site settings happen in the control center
# through the signed /hop/* API (or with the CLI).
PIXELHOP_CONTROL_URL=

# Cloudflare Turnstile on PixelHop's own sign-in and sign-up forms. Optional,
# except with HEL.ink accounts (HELINK_URL): without keys those forms then refuse
# every attempt, and only "Continue with HEL.ink" works.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Hosts of NoteHop. A profile website or report note with an encrypted note link (#k=KEY)
# on one of these hosts is refused or cut, so PixelHop never keeps the note key.
# PIXELHOP_NOTE_HOSTS=note.hel.ink,n.hel.ink

# Server AI tools (optional): address of tools/ai-server.py.
PIXELHOP_REMBG_URL=
PIXELHOP_REMBG_PER_DAY=30

# Command line only, not the server.
# `pixelhop push`: address and API key, instead of ~/.config/pixelhop/client.json.
# PIXELHOP_SERVER=
# PIXELHOP_KEY=
# `pixelhop user add` and `passwd`: the password, instead of asking for it.
# PIXELHOP_PASSWORD=
